# ======================================================================
# Hotel La Rocca - San Marino | .htaccess
# Configurazione Apache per Aruba (Server Linux / Apache)
# ======================================================================

# 1. Impostazioni Generali
DirectoryIndex index.html
Options -Indexes +FollowSymLinks

# 2. Modulo di Riscrittura URL (mod_rewrite)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # A. Forzatura Reindirizzamento HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # B. Redirect 301 da file .html a URL pulito (senza estensione)
    # 1) Redirect /index.html -> /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html[\s?] [NC]
    RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L]

    # 2) Redirect /en/index.html -> /en/
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+en/index\.html[\s?] [NC]
    RewriteRule ^en/index\.html$ https://%{HTTP_HOST}/en/ [R=301,L]

    # 3) Redirect /de/index.html -> /de/
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+de/index\.html[\s?] [NC]
    RewriteRule ^de/index\.html$ https://%{HTTP_HOST}/de/ [R=301,L]

    # 4) Redirect /fr/index.html -> /fr/
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+fr/index\.html[\s?] [NC]
    RewriteRule ^fr/index\.html$ https://%{HTTP_HOST}/fr/ [R=301,L]

    # 5) Redirect 301 di qualsiasi altra richiesta *.html all'URL senza estensione
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^(.+?)\.html$ https://%{HTTP_HOST}/$1 [R=301,L]

    # C. Riscrittura Interna: da URL pulito al rispettivo file .html
    # Gestisce sia la root principale (/camere -> camere.html) che le sottocartelle lingua (/en/camere -> en/camere.html, /de/camere -> de/camere.html)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L,QSA]
</IfModule>

# 3. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Compressione Gzip / Deflate per prestazioni ottimali
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# 5. Caching Risorse Statiche
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

# 6. Pagina di Errore Personalizzata
ErrorDocument 404 /404.html
